import numpy as np
import csv

# Reproductibilité
np.random.seed(42)

# Nombre de patients
n = 120


# 1. IDENTIFIANTS PATIENTS

ID_patient = ["#{:04d}".format(i + 1) for i in range(n)]


# 2. VARIABLES CLINIQUES


age = np.random.randint(45, 85, n)

sexe = np.random.choice(
    ["M", "F"],
    n
)

antecedents = np.random.choice(
    [0, 1],
    n,
    p=[0.7, 0.3]
)

depression = np.random.choice(
    [0, 1],
    n,
    p=[0.6, 0.4]
)

ethnicite = np.random.choice(
    ["Europe", "Afrique", "Asie", "Amerique_Nord", "Amerique_Sud"],
    n
)


# 3. VARIABLES NEUROANATOMIQUES


substance_noire = np.clip(
    np.random.normal(1.2, 0.2, n),
    0.5,
    None
)

noyau_caude = np.clip(
    np.random.normal(2.0, 0.3, n),
    0.5,
    None
)


# 4. BIOMARQUEURS METABOLIQUES


BHB = np.clip(
    np.random.normal(0.8, 0.4, n),
    0.1,
    None
)

glycine = np.clip(
    np.random.normal(2.5, 0.6, n),
    0.1,
    None
)

pyruvate = np.clip(
    np.random.normal(1.0, 0.3, n),
    0.1,
    None
)

serine = np.clip(
    np.random.normal(1.8, 0.5, n),
    0.1,
    None
)

betaine = np.clip(
    np.random.normal(1.2, 0.4, n),
    0.1,
    None
)


# 5. GENERATION DU SCORE


score = (
    0.03 * age
    + 0.8 * depression
    + 0.6 * antecedents
    - 1.2 * substance_noire
    - 0.8 * noyau_caude
    + 0.4 * BHB
    + 0.2 * glycine
    + 0.3 * pyruvate
    + 0.2 * serine
    - 0.1 * betaine
    + np.random.normal(0, 1, n)
)


# 6. NORMALISATION DU SCORE
#    ENTRE 0 ET 4


score = (
    (score - np.min(score))
    / (np.max(score) - np.min(score))
    * 4
)


# 7. CREATION DE L'UPDRS


UPDRS = []

for s in score:

    if s < 0.8:
        UPDRS.append(0)

    elif s < 1.6:
        UPDRS.append(1)

    elif s < 2.4:
        UPDRS.append(2)

    elif s < 3.2:
        UPDRS.append(3)

    else:
        UPDRS.append(4)


# 8. EXPORT DU CSV


with open(
    "parkinson_120.csv",
    "w",
    newline="",
    encoding="utf-8"
) as f:

    writer = csv.writer(f)

    # En-têtes
    writer.writerow([
        "ID_patient",
        "age",
        "sexe",
        "antecedents",
        "ethnicite",
        "depression",
        "substance_noire",
        "noyau_caude",
        "BHB",
        "glycine",
        "pyruvate",
        "serine",
        "betaine",
        "UPDRS"
    ])

    # Données
    for i in range(n):

        writer.writerow([
            ID_patient[i],
            age[i],
            sexe[i],
            antecedents[i],
            ethnicite[i],
            depression[i],
            round(float(substance_noire[i]), 2),
            round(float(noyau_caude[i]), 2),
            round(float(BHB[i]), 2),
            round(float(glycine[i]), 2),
            round(float(pyruvate[i]), 2),
            round(float(serine[i]), 2),
            round(float(betaine[i]), 2),
            UPDRS[i]
        ])

print("Fichier 'parkinson_120.csv' créé avec succès.")
print("Nombre de patients :", n)
